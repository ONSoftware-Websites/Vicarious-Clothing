# ------------------------------------------------------------------
# Vicarious Clothing environment variables
# Copy this file to .env for local development.
# For Vercel: add production values in Project Settings → Environment Variables.
# ------------------------------------------------------------------

# --- Site -----------------------------------------------------------
# Public base URL used for email links, auth redirects, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=https://vicariousclothing.co.uk

# --- Admin gate -----------------------------------------------------
# Required. If absent, admin login rejects every attempt; admin is never left open.
ADMIN_PASSWORD=replace-with-a-long-random-password
# Recommended. Signs admin session cookies separately from the login password.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional. Required only if you want detailed /api/health output in production:
# /api/health?token=<HEALTHCHECK_SECRET>
HEALTHCHECK_SECRET=replace-with-at-least-32-random-bytes

# --- Server-to-server integrations ---------------------------------
# Required before SellerHQ can sync products into the website API.
# Use a long random secret and set the same value in the SellerHQ server/API function.
SELLERHQ_API_KEY=replace-with-at-least-32-random-bytes

# --- Payments (Stripe) ----------------------------------------------
# All three are required in production. Production checkout fails closed
# rather than falling back to a free/demo order when Stripe is missing.
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe webhook endpoint to configure in the Stripe Dashboard:
# https://vicariousclothing.co.uk/api/webhooks/stripe
# Required event: payment_intent.succeeded
# Recommended: payment_intent.payment_failed

# --- Transactional email (Resend) -----------------------------------
# Required in production. Verify vicariousclothing.co.uk in Resend and ensure
# notifications@vicariousclothing.co.uk is permitted as the From address.
RESEND_API_KEY=re_...

# Optional. Where instant paid-order admin alerts are sent. Defaults to
# henry@vicariousclothing.co.uk. Separate multiple recipients with commas.
ORDER_ALERT_EMAIL=henry@vicariousclothing.co.uk

# Optional display text in the branded password-reset email. Match this to your
# Supabase Auth OTP/recovery expiry setting.
PASSWORD_RESET_EXPIRY_LABEL=1 hour

# --- Secure customer links ------------------------------------------
# Use independent long random values. These HMAC-sign guest order links,
# sell-to-us submission/offer links and one-click unsubscribe links. If absent,
# the service-role key is used as a server-only fallback, but dedicated secrets
# are recommended.
ORDER_ACCESS_SECRET=replace-with-at-least-32-random-bytes
LEAD_OFFER_SECRET=replace-with-at-least-32-random-bytes
NEWSLETTER_UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-bytes

# --- Supabase --------------------------------------------------------
# All three are required for production account + durable application data.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# After creating the project:
# 1. Run supabase/schema.sql for a new database.
# 2. Run supabase/repair-2026-08-23.sql for the atomic checkout/discount RPCs
#    and lead-photos Storage bucket used by the current application.
# 3. Run supabase/repair-2026-08-24.sql for tracking compatibility, lead offer
#    expiry metadata and newsletter unsubscribe metadata.
# 4. Optionally run supabase/seed.sql only in a development/test project.
# 5. In Supabase Auth URL Configuration, allow the production callback URL:
#    https://vicariousclothing.co.uk/auth/callback

# --- Local data store ------------------------------------------------
# Local development/tests can still use the in-memory/file store.
# Production API mutations are blocked if Supabase is unavailable so writes
# cannot silently fall back to non-durable serverless memory.
# DATA_STORE=memory

# --- Demo seed -------------------------------------------------------
# Set false on Vercel Production + Preview. Leave unset locally if you want demo data.
SEED_DEMO=false
