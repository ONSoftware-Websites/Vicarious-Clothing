# ------------------------------------------------------------------
# Vicarious Clothing environment variables
# Copy this file to .env and fill in what you need.
# For Vercel: add these in Project Settings → Environment Variables.
# ------------------------------------------------------------------

# --- Site -----------------------------------------------------------
# Public base URL (used for sitemap, robots, Open Graph, email links).
# Unset = https://vicariousclothing.co.uk. Set on Vercel to your real
# domain, or your preview URL for staging.
# NEXT_PUBLIC_SITE_URL=https://vicariousclothing.co.uk

# --- Admin gate -----------------------------------------------------
# The password for /admin. Without it, /admin is open (dev convenience).
ADMIN_PASSWORD=ADMINPASSWORD123

# --- Payments (Stripe) ----------------------------------------------
# Custom on-site checkout (Payment Element). Leave blank to run the
# checkout in demo mode (no real payment).
# Get keys at https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret from: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Transactional email (Resend) -----------------------------------
# Leave blank to log emails to .data/emails/*.html instead of sending.
# Get a key at https://resend.com — verify your domain first.
# RESEND_API_KEY=re_...

# --- Supabase (Phase 2 swap-in) --------------------------------------
# Project URL and anon key from https://supabase.com/dashboard (Settings → API)
# Then run supabase/schema.sql in the SQL editor.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Data store ------------------------------------------------------
# Not required. On Vercel the file-backed demo store automatically runs
# in memory (serverless filesystems are read-only). Set DATA_STORE=memory
# to force it anywhere. Production data belongs in Supabase.
# DATA_STORE=memory
