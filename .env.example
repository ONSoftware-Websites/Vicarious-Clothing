# ------------------------------------------------------------------
# Vicarious Clothing environment variables
# Copy this file to .env for local development.
# For Vercel: add production values in Project Settings → Environment Variables.
# ------------------------------------------------------------------

# --- Site -----------------------------------------------------------
# Public base URL used for email links, auth redirects, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=https://vicariousclothing.co.uk

# --- Admin gate -----------------------------------------------------
# Required. If absent, admin login rejects every attempt; admin is never left open.
ADMIN_PASSWORD=replace-with-a-long-random-password

# --- Payments (Stripe) ----------------------------------------------
# All three are required in production. Production checkout now fails closed
# rather than falling back to a free/demo order when Stripe is missing.
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe webhook endpoint to configure in the Stripe Dashboard:
# https://vicariousclothing.co.uk/api/webhooks/stripe
# Required event: payment_intent.succeeded
# Recommended: payment_intent.payment_failed

# --- Transactional email (Resend) -----------------------------------
# Required in production. Verify vicariousclothing.co.uk in Resend and ensure
# notifications@vicariousclothing.co.uk is permitted as the From address.
RESEND_API_KEY=re_...

# Optional display text in the branded password-reset email. Match this to your
# Supabase Auth OTP/recovery expiry setting.
PASSWORD_RESET_EXPIRY_LABEL=1 hour

# --- Sell-to-us secure customer links -------------------------------
# Recommended: an independent long random secret used to sign customer lead URLs.
# If omitted, the server-only Supabase service-role key is used as a fallback.
LEAD_OFFER_SECRET=replace-with-at-least-32-random-bytes

# --- Supabase --------------------------------------------------------
# All three are required for production account + durable application data.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# After creating the project:
# 1. Run supabase/schema.sql for a new database.
# 2. Run supabase/repair-2026-08-23.sql for the atomic checkout claim RPC and
#    lead-photos Storage bucket used by the current application.
# 3. Optionally run supabase/seed.sql only in a development/test project.

# --- Local data store ------------------------------------------------
# Local development/tests can still use the in-memory/file store.
# Production API mutations are blocked if Supabase is unavailable so writes
# cannot silently fall back to non-durable serverless memory.
# DATA_STORE=memory

# --- Demo seed -------------------------------------------------------
# Set false on Vercel Production + Preview. Leave unset locally if you want demo data.
SEED_DEMO=false
